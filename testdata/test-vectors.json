{
  "vectors": [
    {
      "name": "fixed_window_allows_up_to_limit_then_denies",
      "algorithm": "fixed_window",
      "limit": 3,
      "window_seconds": 1,
      "requests": [
        { "now_ms": 0,   "expected_allowed": true,  "expected_remaining": 2 },
        { "now_ms": 100, "expected_allowed": true,  "expected_remaining": 1 },
        { "now_ms": 200, "expected_allowed": true,  "expected_remaining": 0 },
        { "now_ms": 300, "expected_allowed": false, "expected_remaining": 0 }
      ]
    },
    {
      "name": "fixed_window_resets_next_window",
      "algorithm": "fixed_window",
      "limit": 2,
      "window_seconds": 1,
      "requests": [
        { "now_ms": 0,    "expected_allowed": true },
        { "now_ms": 500,  "expected_allowed": true },
        { "now_ms": 600,  "expected_allowed": false },
        { "now_ms": 1000, "expected_allowed": true }
      ]
    },
    {
      "name": "token_bucket_allows_burst_up_to_capacity",
      "algorithm": "token_bucket",
      "limit": 10,
      "window_seconds": 10,
      "params": { "burst": 5 },
      "requests": [
        { "now_ms": 0, "expected_allowed": true },
        { "now_ms": 0, "expected_allowed": true },
        { "now_ms": 0, "expected_allowed": true },
        { "now_ms": 0, "expected_allowed": true },
        { "now_ms": 0, "expected_allowed": true },
        { "now_ms": 0, "expected_allowed": false }
      ]
    },
    {
      "name": "token_bucket_refills_over_time",
      "algorithm": "token_bucket",
      "limit": 10,
      "window_seconds": 10,
      "params": { "burst": 2 },
      "requests": [
        { "now_ms": 0,    "expected_allowed": true },
        { "now_ms": 0,    "expected_allowed": true },
        { "now_ms": 0,    "expected_allowed": false },
        { "now_ms": 1000, "expected_allowed": true },
        { "now_ms": 1000, "expected_allowed": false }
      ]
    },
    {
      "name": "sliding_window_counter_smooths_boundary",
      "algorithm": "sliding_window_counter",
      "limit": 5,
      "window_seconds": 1,
      "requests": [
        { "now_ms": 0,    "expected_allowed": true },
        { "now_ms": 200,  "expected_allowed": true },
        { "now_ms": 400,  "expected_allowed": true },
        { "now_ms": 600,  "expected_allowed": true },
        { "now_ms": 800,  "expected_allowed": true },
        { "now_ms": 900,  "expected_allowed": false },
        { "now_ms": 1300, "expected_allowed": true }
      ]
    }
  ]
}
